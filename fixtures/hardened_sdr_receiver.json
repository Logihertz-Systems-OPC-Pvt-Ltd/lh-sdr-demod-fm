{
  "$schema": "https://logihertz.com/schemas/sdr-receiver-v1.json",
  "receiver_id": "lh-sdr-edge-orin-01",
  "organization": "Logihertz Systems (OPC) Private Limited",
  "profile": "hardened-wbfm-telemetry-receiver",
  "mode": "WBFM",
  "sample_rate_hz": 240000.0,
  "freq_deviation_hz": 75000.0,
  "max_audio_freq_hz": 15000.0,
  "adc_clipping_guard_enabled": true,
  "lna_gain_db": 32.0,
  "iq_network_server_enabled": false,
  "bind_address": "127.0.0.1",
  "dc_offset_correction": true,
  "iq_imbalance_correction": true,
  "squelch_enabled": true,
  "squelch_threshold_dbfs": -65.0,
  "anti_alias_filter_taps": 35,
  "max_iq_buffer_mb": 128,
  "dma_ring_bounds_check": true,
  "deemphasis_tau_us": 50.0,
  "ppm_correction_enabled": true,
  "max_lo_drift_ppm": 0.5,
  "rf_preselector_enabled": true,
  "biastee_overcurrent_guard": true
}
